+    /// Takes ownership of a complete serialized dictionary already held in aligned storage.
+    pub fn from_aligned_bytes(bytes: AlignedDictionaryBytes) -> Result<Self> {
+        if bytes.0.len() < DATA_START {
+            return Err(VibratoError::invalid_argument("bytes", "Data too short."));
+        }
+        let magic = &bytes.0[..MODEL_MAGIC_LEN];
+        if magic.starts_with(LEGACY_MODEL_MAGIC_PREFIX) {
+            return Err(VibratoError::invalid_argument("bytes", "Legacy dictionary is unsupported."));
